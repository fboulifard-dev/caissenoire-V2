PORT=3000
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"

# Alternative locale: FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Email SMTP IONOS (ne pas versionner les identifiants)
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=compte@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=compte@example.com
# URL publique de la page de connexion pour cet environnement
EMAIL_VERIFICATION_URL=http://localhost:4200/login
